{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/filecoin-project/ff-sec-actions/schemas/evaluation-result.schema.json",
  "title": "Filecoin Ecosystem Security Evaluation Result",
  "description": "Stable v1 contract separating evaluation completion, observed findings, and merge-gate policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation",
    "tool",
    "scope",
    "completion",
    "coverage",
    "findings",
    "suppressions",
    "merge_gate",
    "timing",
    "evidence"
  ],
  "properties": {
    "schema_version": { "enum": ["1.0.0", "1.1.0"] },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["scanner", "ai-review"] }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "target"],
      "properties": {
        "repository": { "type": ["string", "null"] },
        "ref": { "type": ["string", "null"] },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["complete", "incomplete", "skipped", "error"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "included", "excluded", "limitations"],
      "properties": {
        "status": { "enum": ["complete", "partial", "not-applicable", "unknown"] },
        "included": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "highest_severity"],
      "properties": {
        "count": { "type": ["integer", "null"], "minimum": 0 },
        "highest_severity": {
          "enum": ["critical", "high", "medium", "low", "info", "none", "unknown"]
        }
      }
    },
    "suppressions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "sources"],
      "properties": {
        "count": { "type": ["integer", "null"], "minimum": 0 },
        "sources": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "merge_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "conclusion", "reason"],
      "properties": {
        "mode": { "enum": ["advisory", "blocking"] },
        "conclusion": { "enum": ["pass", "fail", "not-evaluated"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at", "duration_ms"],
      "properties": {
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "sha256"],
        "properties": {
          "type": { "enum": ["sarif", "json", "log", "none"] },
          "path": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "artifact": { "type": ["string", "null"], "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "none" } } },
            "then": {
              "properties": {
                "path": { "type": "null" },
                "sha256": { "type": "null" }
              }
            },
            "else": {
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.0.0"}}},
      "then": {
        "properties": {
          "evidence": {"items": {"not": {"required": ["artifact"]}}}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.1.0"}}},
      "then": {
        "properties": {
          "evidence": {"items": {"required": ["artifact"]}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "completion": {
            "properties": { "status": { "const": "complete" } },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "properties": { "count": { "type": "integer" } }
          },
          "merge_gate": {
            "properties": { "conclusion": { "enum": ["pass", "fail"] } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "completion": {
            "properties": { "status": { "const": "error" } },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "merge_gate": {
            "properties": { "conclusion": { "const": "fail" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "completion": {
            "properties": { "status": { "const": "skipped" } },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "properties": {
              "count": { "type": "null" },
              "highest_severity": { "const": "unknown" }
            }
          },
          "merge_gate": {
            "properties": { "conclusion": { "const": "not-evaluated" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "findings": {
            "properties": { "count": { "const": 0 } },
            "required": ["count"]
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "properties": { "highest_severity": { "const": "none" } }
          }
        }
      }
    }
  ]
}
