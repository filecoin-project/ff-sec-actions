{
  "schema_version": 1,
  "workflows": {
    ".github/workflows/ecosystem-baseline.yml": {
      "coverage_mode": "source-manifest",
      "allowed_actions": [
        "actions/download-artifact",
        "actions/upload-artifact",
        "filecoin-project/ff-sec-actions/.github/workflows/sec-actions.yml",
        "filecoin-project/ff-sec-actions/.github/workflows/sec-dependencies.yml",
        "filecoin-project/ff-sec-actions/.github/workflows/sec-iac.yml",
        "filecoin-project/ff-sec-actions/.github/workflows/sec-secrets.yml",
        "filecoin-project/ff-sec-actions/.github/workflows/sec-semgrep.yml",
        "filecoin-project/ff-sec-actions/actions/aggregate-results"
      ],
      "limitations": [
        "The baseline inspects workflow definitions, Git history, source, configuration, manifests, and lockfiles without building the project.",
        "Installed, build-generated, runtime-loaded, and unsupported-language behavior is excluded and remains visible in the Evidence Bundle."
      ]
    },
    ".github/workflows/sec-actions.yml": {
      "coverage_mode": "workflow-definitions",
      "allowed_actions": [
        "actions/checkout",
        "actions/upload-artifact",
        "filecoin-project/ff-sec-actions/actions/evaluation-adapter",
        "filecoin-project/ff-sec-actions/actions/zizmor-scan"
      ],
      "limitations": [
        "Offline audits do not resolve remote action metadata or repository state.",
        "Auditor-persona findings below medium severity are excluded from the default gate."
      ]
    },
    ".github/workflows/sec-dependencies.yml": {
      "coverage_mode": "manifest-and-lockfile",
      "allowed_actions": [
        "actions/checkout",
        "actions/upload-artifact",
        "aquasecurity/trivy-action",
        "filecoin-project/ff-sec-actions/actions/evaluation-adapter"
      ],
      "limitations": [
        "Native package-manager reachability and installed dependency state are excluded.",
        "Build-generated manifests are excluded."
      ]
    },
    ".github/workflows/sec-licenses.yml": {
      "coverage_mode": "manifest-and-lockfile",
      "allowed_actions": [
        "actions/checkout",
        "actions/upload-artifact",
        "aquasecurity/trivy-action",
        "filecoin-project/ff-sec-actions/actions/scanner-outcome"
      ],
      "limitations": [
        "Licenses visible only after installation or a project build are excluded."
      ]
    },
    ".github/workflows/sec-iac.yml": {
      "coverage_mode": "source-manifest",
      "allowed_actions": [
        "actions/checkout",
        "actions/upload-artifact",
        "aquasecurity/trivy-action",
        "filecoin-project/ff-sec-actions/actions/evaluation-adapter"
      ],
      "limitations": [
        "Runtime cloud state and configuration generated only during a build are excluded."
      ]
    },
    ".github/workflows/sec-secrets.yml": {
      "coverage_mode": "git-history",
      "allowed_actions": [
        "actions/checkout",
        "actions/upload-artifact",
        "filecoin-project/ff-sec-actions/actions/gitleaks-scan",
        "filecoin-project/ff-sec-actions/actions/evaluation-adapter"
      ],
      "limitations": [
        "Pull requests inspect only commits introduced by the pull request.",
        "Scheduled, push, and manual runs inspect all locally fetched Git history."
      ]
    },
    ".github/workflows/sec-sbom.yml": {
      "coverage_mode": "source-manifest",
      "allowed_actions": [
        "actions/checkout",
        "anchore/sbom-action"
      ],
      "limitations": [
        "The SBOM is source-manifest evidence, not a build-complete inventory.",
        "Generated, vendored-at-build, and runtime-loaded packages may be absent."
      ]
    },
    ".github/workflows/sec-semgrep.yml": {
      "coverage_mode": "source-manifest",
      "allowed_actions": [
        "actions/checkout",
        "actions/upload-artifact",
        "filecoin-project/ff-sec-actions/actions/evaluation-adapter",
        "filecoin-project/ff-sec-actions/actions/semgrep-scan"
      ],
      "limitations": [
        "The conservative ruleset supports selected Go, Rust, JavaScript, TypeScript, Solidity, and Dockerfile patterns; it is not a complete language audit."
      ]
    }
  }
}
